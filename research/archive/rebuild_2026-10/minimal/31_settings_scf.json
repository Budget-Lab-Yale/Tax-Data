    "interest": "PUF taxable interest (E00300); SCF X5708",
    "dividends": "PUF ordinary dividends (E00600); SCF X5710",
    "capital_gains": "PUF line 13 (kg_st + kg_lt + kg_dist + kg_other); SCF X5712 with every loss below -$3,000 set to -$3,000 first"
